{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"],
    "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "resolveJsonModule": true, "esModuleInterop": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["vite/client"]
  },
  "include": ["src", "tests"]
}
